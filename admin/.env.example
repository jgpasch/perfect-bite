# Copy to .env.local (gitignored). Only project URLs and publishable keys: never a secret or service-role key.
# SUPABASE_TARGET picks which pair the portal uses: local or hosted. Restart `yarn admin` after changing it,
# or override it for one run: `SUPABASE_TARGET=hosted yarn admin`.
SUPABASE_TARGET=local

# Local: `supabase status` shows the publishable key (the API URL is http://127.0.0.1:55321).
SUPABASE_LOCAL_URL=http://127.0.0.1:55321
SUPABASE_LOCAL_PUBLISHABLE_KEY=

# Hosted: Project Settings → API Keys in the Supabase dashboard (same pair as the app's .env.production).
SUPABASE_HOSTED_URL=https://<project-ref>.supabase.co
SUPABASE_HOSTED_PUBLISHABLE_KEY=
