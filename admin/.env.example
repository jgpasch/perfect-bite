# Copy to .env.local (gitignored). Only the project URL and publishable key: never a secret or service-role key.
# Local: `supabase status` shows both (the API URL is http://127.0.0.1:55321).
# Hosted: Project Settings → API Keys in the Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
