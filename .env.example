# App environment. Copy to .env.local (gitignored) and fill in from `supabase status`.
# The publishable key is safe to ship in the app.
# On a physical device, replace 127.0.0.1 with your Mac's LAN IP.
# Ports are 553xx (not Supabase's default 543xx) so this project and stash can run side by side.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:55321
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Google sign-in (spec 4.8). OAuth client IDs from Google Cloud, not secrets. The iOS client's URL
# scheme is in app.json. The web client's secret goes in supabase/.env, never here.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=1031126351526-q2tn88imviuf5j9stsjqmb34pisoc7ng.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=1031126351526-ogsi69sb0keib4ea84k7o772q2ijv5ga.apps.googleusercontent.com
