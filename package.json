  "private": true,
  "packageManager": "yarn@4.18.0",
  "resolutions": {
    "expo-modules-jsi@npm:~57.1.1": "patch:expo-modules-jsi@npm%3A57.1.1#~/.yarn/patches/expo-modules-jsi-npm-57.1.1-3b93696200.patch"
