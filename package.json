  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "admin": "yarn --cwd admin dev",
    "test": "jest",
    "ai:categorize": "deno run --allow-env --allow-net --allow-read --allow-sys --env-file=supabase/functions/.env supabase/functions/categorize-ingredients/cli.ts",
    "ai:eval": "deno run --allow-env --allow-net --allow-read --allow-sys --env-file=supabase/functions/.env supabase/functions/categorize-ingredients/eval/eval.ts",
    "ai:unlink": "deno run --allow-env --allow-net --allow-read --allow-sys supabase/functions/categorize-ingredients/unlink.ts",
    "ai:translations": "deno run --allow-env --allow-net --allow-read --allow-write --allow-sys supabase/functions/categorize-ingredients/translations.ts",
    "ai:prune-twins": "deno run --allow-env --allow-net --allow-read --allow-sys supabase/functions/categorize-ingredients/prune-twins.ts",
    "ai:check-seed": "deno run --allow-env --allow-net --allow-read --allow-write=supabase/functions/categorize-ingredients/eval/results --allow-sys --env-file=supabase/functions/.env supabase/functions/categorize-ingredients/eval/check-seed.ts",
    "ai:recipe": "deno run --allow-env --allow-net --allow-read --allow-sys --env-file=supabase/functions/.env supabase/functions/import-recipe/cli.ts",
    "ai:recipe-photo": "deno run --allow-env --allow-net --allow-read --allow-sys --allow-run=sips --env-file=supabase/functions/.env supabase/functions/import-recipe-photo/cli.ts",
    "ai:tags": "deno run --allow-env --allow-net --allow-read --allow-sys --env-file=supabase/functions/.env supabase/functions/suggest-recipe-tags/cli.ts",
    "ai:eval:recipe": "deno run --allow-env --allow-net --allow-read --allow-sys --env-file=supabase/functions/.env supabase/functions/import-recipe/eval/eval.ts",
    "ai:steps": "deno run --allow-env --allow-net --allow-read --allow-sys --env-file=supabase/functions/.env supabase/functions/match-recipe-steps/cli.ts",
    "ai:image": "deno run --allow-env --allow-net --allow-read --allow-write=generated-images --allow-sys --env-file=supabase/functions/.env supabase/functions/generate-recipe-photo/cli.ts",
    "ai:eval:photo": "deno run --allow-env --allow-net --allow-read --allow-sys --env-file=supabase/functions/.env supabase/functions/generate-recipe-photo/eval/eval.ts",
    "ai:eval:steps": "deno run --allow-env --allow-net --allow-read --allow-sys --env-file=supabase/functions/.env supabase/functions/match-recipe-steps/eval/eval.ts",
    "e2e": "scripts/e2e.sh",
    "deploy": "scripts/deploy.sh",
    "deploy:local": "scripts/deploy.sh --local",
    "deploy:backend": "scripts/deploy.sh --backend",
    "build:ios:local": "scripts/build-ios-local.sh",
    "submit:ios:local": "scripts/submit-ios.sh",
    "deploy:ios:local": "scripts/build-ios-local.sh && scripts/submit-ios.sh",
    "db:seed-sql": "deno run --allow-read --allow-write=supabase/migrations scripts/gen-seed-sql.ts",
    "seed:es-plurals": "deno run --allow-read --allow-write=src/shared/spanish-plurals.ts scripts/gen-es-plurals.ts",
    "i18n:export": "deno run --no-lock --allow-read --allow-write=docs/i18n scripts/i18n-export.ts",
    "dev:ai-refusals": "deno run --no-lock --allow-env=DATABASE_URL --allow-run=psql scripts/ai-refusals.ts",
    "review:tasks": "deno run --no-lock --allow-read --allow-write=tasks.md,review scripts/review-tasks.ts"
