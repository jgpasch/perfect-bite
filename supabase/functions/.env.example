# Edge Function secrets. Copy to supabase/functions/.env (gitignored) for
# `supabase functions serve`; set in production with `supabase secrets set`.
# A provider is registered only if its key is present (docs/spec.md §6.4).
ANTHROPIC_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
# Model for ingredient categorization (provider:model). `mock` uses a deterministic
# fake with no key and no cost; tests always use the mock. `off` makes no model calls.
AI_MODEL_CATEGORIZE=google:gemini-3.8-flash
# Optional model tried when the primary's API call fails. Unset = no fallback.
# AI_MODEL_CATEGORIZE_FALLBACK=
# Model for recipe extraction (import-recipe, spec §6.6). Same values as above; `off` is the
# kill switch.
AI_MODEL_RECIPE=google:gemini-3.8-flash
# Optional model tried when the primary's API call fails. Unset = no fallback.
# AI_MODEL_RECIPE_FALLBACK=
# Model for photo imports (import-recipe-photo, spec §6.10). It must take images. Unset =
# AI_MODEL_RECIPE (and its fallback); `off` is the kill switch. AI_THINKING_RECIPE_PHOTO
# overrides the thinking setting.
# AI_MODEL_RECIPE_PHOTO=
# AI_MODEL_RECIPE_PHOTO_FALLBACK=
# AI_THINKING_RECIPE_PHOTO=
# Model for tag suggestions (suggest-recipe-tags, spec §6.7). Unset = AI_MODEL_RECIPE (and its
# fallback); `off` is the kill switch.
# AI_MODEL_TAGS=
# AI_MODEL_TAGS_FALLBACK=
# Model for matching ingredients to steps (match-recipe-steps, spec §6.8; docs/spikes.md §5).
# Unset = AI_MODEL_RECIPE (and its fallback); `off` is the kill switch. AI_THINKING_STEPS
# overrides the thinking setting.
# AI_MODEL_STEPS=
# AI_MODEL_STEPS_FALLBACK=
# AI recipe photos (generate-recipe-photo, spec §6.11). The description step uses
# AI_MODEL_PHOTO_DESCRIPTION, unset = the tag suggester's model (AI_MODEL_TAGS, else AI_MODEL_RECIPE,
# and their fallbacks); AI_THINKING_PHOTO_DESCRIPTION overrides its thinking setting. The image is
# made by OpenAI's Images API with OPENAI_API_KEY: AI_IMAGE_MODEL (unset = gpt-image-1-mini; `mock`
# answers a fixed JPEG, `off` is the kill switch) at AI_IMAGE_QUALITY (low, medium, high or auto;
# unset = medium). About a cent a photo on mini at medium.
OPENAI_API_KEY=
# AI_MODEL_PHOTO_DESCRIPTION=
# AI_MODEL_PHOTO_DESCRIPTION_FALLBACK=
# AI_THINKING_PHOTO_DESCRIPTION=
# AI_IMAGE_MODEL=gpt-image-1-mini
# AI_IMAGE_QUALITY=medium
# Expo access token for send-notifications (push, spec 4.13), needed only if enhanced push
# security is on for the Expo project. Unset = requests go without an Authorization header.
# EXPO_ACCESS_TOKEN=
# Error reporting (Sentry): the DSN of the backend's Sentry project. Unset = nothing is reported
# (leave it unset locally). Every 500 is reported, cron failures included.
# SENTRY_DSN=
