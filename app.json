{
  "expo": {
    "name": "The Perfect Bite",
    "slug": "perfect-bite",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon/icon-light.png",
    "scheme": "perfectbite",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.jgp.perfectbite",
      "supportsTablet": false,
      "icon": {
        "light": "./assets/icon/icon-light.png",
        "dark": "./assets/icon/icon-dark.png",
        "tinted": "./assets/icon/icon-tinted.png"
      },
      "entitlements": {
        "com.apple.security.application-groups": [
          "group.com.jgp.perfectbite"
        ]
      },
      "appleTeamId": "4537GH756L",
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "INAlternativeAppNames": [
          {
            "INAlternativeAppName": "Perfect Bite"
          }
        ]
      }
    },
    "android": {
      "package": "com.jgp.perfectbite",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1F4D33",
          "image": "./assets/images/splash-cloche.png",
          "imageWidth": 200,
          "dark": {
            "backgroundColor": "#163A26",
            "image": "./assets/images/splash-cloche.png"
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "The Perfect Bite uses your photos so you can add one to a recipe.",
          "cameraPermission": "The Perfect Bite uses the camera so you can take a photo of a recipe.",
          "microphonePermission": false
        }
      ],
      [
        "expo-font",
        {
          "ios": {
            "fonts": [
              "./node_modules/@expo-google-fonts/bricolage-grotesque/500Medium/BricolageGrotesque_500Medium.ttf",
              "./node_modules/@expo-google-fonts/bricolage-grotesque/600SemiBold/BricolageGrotesque_600SemiBold.ttf",
              "./node_modules/@expo-google-fonts/bricolage-grotesque/700Bold/BricolageGrotesque_700Bold.ttf",
              "./node_modules/@expo-google-fonts/bricolage-grotesque/800ExtraBold/BricolageGrotesque_800ExtraBold.ttf",
              "./node_modules/@expo-google-fonts/figtree/400Regular/Figtree_400Regular.ttf",
              "./node_modules/@expo-google-fonts/figtree/500Medium/Figtree_500Medium.ttf",
              "./node_modules/@expo-google-fonts/figtree/600SemiBold/Figtree_600SemiBold.ttf",
              "./node_modules/@expo-google-fonts/figtree/700Bold/Figtree_700Bold.ttf",
              "./node_modules/@expo-google-fonts/fraunces/600SemiBold/Fraunces_600SemiBold.ttf",
              "./node_modules/@expo-google-fonts/fraunces/700Bold/Fraunces_700Bold.ttf",
              "./node_modules/@expo-google-fonts/young-serif/400Regular/YoungSerif_400Regular.ttf",
              "./node_modules/@expo-google-fonts/instrument-sans/400Regular/InstrumentSans_400Regular.ttf",
              "./node_modules/@expo-google-fonts/instrument-sans/500Medium/InstrumentSans_500Medium.ttf",
              "./node_modules/@expo-google-fonts/instrument-sans/600SemiBold/InstrumentSans_600SemiBold.ttf",
              "./node_modules/@expo-google-fonts/instrument-sans/700Bold/InstrumentSans_700Bold.ttf",
              "./node_modules/@expo-google-fonts/plus-jakarta-sans/400Regular/PlusJakartaSans_400Regular.ttf",
              "./node_modules/@expo-google-fonts/plus-jakarta-sans/500Medium/PlusJakartaSans_500Medium.ttf",
              "./node_modules/@expo-google-fonts/plus-jakarta-sans/600SemiBold/PlusJakartaSans_600SemiBold.ttf",
              "./node_modules/@expo-google-fonts/plus-jakarta-sans/700Bold/PlusJakartaSans_700Bold.ttf",
              "./node_modules/@expo-google-fonts/plus-jakarta-sans/800ExtraBold/PlusJakartaSans_800ExtraBold.ttf",
              "./node_modules/@expo-google-fonts/nunito/800ExtraBold/Nunito_800ExtraBold.ttf",
              "./node_modules/@expo-google-fonts/nunito/900Black/Nunito_900Black.ttf",
              "./node_modules/@expo-google-fonts/nunito-sans/400Regular/NunitoSans_400Regular.ttf",
              "./node_modules/@expo-google-fonts/nunito-sans/500Medium/NunitoSans_500Medium.ttf",
              "./node_modules/@expo-google-fonts/nunito-sans/600SemiBold/NunitoSans_600SemiBold.ttf",
              "./node_modules/@expo-google-fonts/nunito-sans/700Bold/NunitoSans_700Bold.ttf"
            ]
          },
          "android": {
            "fonts": [
              {
                "fontFamily": "Bricolage Grotesque",
                "fontDefinitions": [
                  {
                    "path": "./node_modules/@expo-google-fonts/bricolage-grotesque/500Medium/BricolageGrotesque_500Medium.ttf",
                    "weight": 500
                  },
                  {
                    "path": "./node_modules/@expo-google-fonts/bricolage-grotesque/600SemiBold/BricolageGrotesque_600SemiBold.ttf",
                    "weight": 600
                  },
                  {
                    "path": "./node_modules/@expo-google-fonts/bricolage-grotesque/700Bold/BricolageGrotesque_700Bold.ttf",
                    "weight": 700
                  },
                  {
                    "path": "./node_modules/@expo-google-fonts/bricolage-grotesque/800ExtraBold/BricolageGrotesque_800ExtraBold.ttf",
                    "weight": 800
                  }
                ]
              },
              {
                "fontFamily": "Figtree",
                "fontDefinitions": [
                  {
                    "path": "./node_modules/@expo-google-fonts/figtree/400Regular/Figtree_400Regular.ttf",
                    "weight": 400
                  },
                  {
                    "path": "./node_modules/@expo-google-fonts/figtree/500Medium/Figtree_500Medium.ttf",
                    "weight": 500
                  },
                  {
                    "path": "./node_modules/@expo-google-fonts/figtree/600SemiBold/Figtree_600SemiBold.ttf",
                    "weight": 600
                  },
                  {
                    "path": "./node_modules/@expo-google-fonts/figtree/700Bold/Figtree_700Bold.ttf",
                    "weight": 700
                  }
                ]
              },
              {
                "fontFamily": "Fraunces",
                "fontDefinitions": [
                  {
                    "path": "./node_modules/@expo-google-fonts/fraunces/600SemiBold/Fraunces_600SemiBold.ttf",
                    "weight": 600
                  },
                  {
                    "path": "./node_modules/@expo-google-fonts/fraunces/700Bold/Fraunces_700Bold.ttf",
                    "weight": 700
                  }
                ]
              },
              {
                "fontFamily": "Young Serif",
                "fontDefinitions": [
                  {
                    "path": "./node_modules/@expo-google-fonts/young-serif/400Regular/YoungSerif_400Regular.ttf",
                    "weight": 400
                  }
                ]
              },
              {
                "fontFamily": "Instrument Sans",
                "fontDefinitions": [
                  {
                    "path": "./node_modules/@expo-google-fonts/instrument-sans/400Regular/InstrumentSans_400Regular.ttf",
                    "weight": 400
                  },
                  {
                    "path": "./node_modules/@expo-google-fonts/instrument-sans/500Medium/InstrumentSans_500Medium.ttf",
                    "weight": 500
                  },
                  {
                    "path": "./node_modules/@expo-google-fonts/instrument-sans/600SemiBold/InstrumentSans_600SemiBold.ttf",
                    "weight": 600
                  },
                  {
                    "path": "./node_modules/@expo-google-fonts/instrument-sans/700Bold/InstrumentSans_700Bold.ttf",
                    "weight": 700
                  }
                ]
              },
              {
                "fontFamily": "Plus Jakarta Sans",
                "fontDefinitions": [
                  {
                    "path": "./node_modules/@expo-google-fonts/plus-jakarta-sans/400Regular/PlusJakartaSans_400Regular.ttf",
                    "weight": 400
                  },
                  {
                    "path": "./node_modules/@expo-google-fonts/plus-jakarta-sans/500Medium/PlusJakartaSans_500Medium.ttf",
                    "weight": 500
                  },
                  {
                    "path": "./node_modules/@expo-google-fonts/plus-jakarta-sans/600SemiBold/PlusJakartaSans_600SemiBold.ttf",
                    "weight": 600
                  },
                  {
                    "path": "./node_modules/@expo-google-fonts/plus-jakarta-sans/700Bold/PlusJakartaSans_700Bold.ttf",
                    "weight": 700
                  },
                  {
                    "path": "./node_modules/@expo-google-fonts/plus-jakarta-sans/800ExtraBold/PlusJakartaSans_800ExtraBold.ttf",
                    "weight": 800
                  }
                ]
              },
              {
                "fontFamily": "Nunito",
                "fontDefinitions": [
                  {
                    "path": "./node_modules/@expo-google-fonts/nunito/800ExtraBold/Nunito_800ExtraBold.ttf",
                    "weight": 800
                  },
                  {
                    "path": "./node_modules/@expo-google-fonts/nunito/900Black/Nunito_900Black.ttf",
                    "weight": 900
                  }
                ]
              },
              {
                "fontFamily": "Nunito Sans",
                "fontDefinitions": [
                  {
                    "path": "./node_modules/@expo-google-fonts/nunito-sans/400Regular/NunitoSans_400Regular.ttf",
                    "weight": 400
                  },
                  {
                    "path": "./node_modules/@expo-google-fonts/nunito-sans/500Medium/NunitoSans_500Medium.ttf",
                    "weight": 500
                  },
                  {
                    "path": "./node_modules/@expo-google-fonts/nunito-sans/600SemiBold/NunitoSans_600SemiBold.ttf",
                    "weight": 600
                  },
                  {
                    "path": "./node_modules/@expo-google-fonts/nunito-sans/700Bold/NunitoSans_700Bold.ttf",
                    "weight": 700
                  }
                ]
              }
            ]
          }
        }
      ],
      "expo-sqlite",
      "@bacons/apple-targets",
      "./plugins/with-scene-lifecycle",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.1031126351526-q2tn88imviuf5j9stsjqmb34pisoc7ng"
        }
      ],
      "expo-mail-composer",
      "expo-notifications",
      "expo-localization",
      [
        "expo-build-properties",
        {
          "ios": {
            "usePrecompiledModules": false
          }
        }
      ],
      [
        "@sentry/react-native",
        {
          "url": "https://sentry.io/",
          "organization": "john-paschal",
          "project": "perfect-bite"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "bundleIdentifier": "com.jgp.perfectbite.share",
                  "targetName": "ShareRecipe",
                  "entitlements": {
                    "com.apple.security.application-groups": [
                      "group.com.jgp.perfectbite"
                    ]
                  }
                },
                {
                  "bundleIdentifier": "com.jgp.perfectbite.addintent",
                  "targetName": "AddIntent",
                  "entitlements": {
                    "com.apple.security.application-groups": [
                      "group.com.jgp.perfectbite"
                    ]
                  }
                }
              ]
            }
          }
        },
        "projectId": "eb79b313-81d7-46ca-a28b-2666db613c67"
      }
    }
  }
}
